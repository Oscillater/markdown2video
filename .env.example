# LLM Planner 配置（可选）
# 不配置则使用 Rule Planner，无需任何 API Key

# Planner 类型: rule（默认）或 llm
# MD2VIDEO_PLANNER=rule

# LLM 模型（pydantic-ai 格式）
# MD2VIDEO_LLM_MODEL=openai:gpt-4o

# API Key（二选一，也可直接设系统环境变量）
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# 兼容 API 地址（可选，如中转站）
# MD2VIDEO_LLM_BASE_URL=https://your-api-endpoint/v1
